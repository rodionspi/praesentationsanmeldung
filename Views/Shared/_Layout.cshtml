<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] – Präsentationsanmeldung</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
</head>
<body>
    <nav class="navbar navbar-expand-md navbar-dark bg-primary mb-4">
        <div class="container">
            <span class="navbar-brand">Präsentationsanmeldung</span>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menu" aria-controls="menu" aria-expanded="false" aria-label="Menü">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="menu">
                    <ul class="navbar-nav me-auto">
                        @if (User.IsInRole(Rollen.Admin))
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Import" asp-action="Index">CSV-Import</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Raeume" asp-action="Index">Räume</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Praesentationen" asp-action="Index">Präsentationen</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Uebersicht" asp-action="Index">Übersicht</a></li>
                        }
                        else
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Anmeldung" asp-action="Index">Präsentationen</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Anmeldung" asp-action="Meine">Meine Eintragungen</a></li>
                        }
                    </ul>
                    <span class="navbar-text me-3">@User.Identity?.Name</span>
                    <form asp-controller="Account" asp-action="Logout" class="d-flex">
                        <button type="submit" class="btn btn-outline-light btn-sm">Abmelden</button>
                    </form>
                </div>
            }
        </div>
    </nav>

    <main class="container mb-5">
        <h1 class="h3 mb-4">@ViewData["Title"]</h1>

        @if (TempData["Meldung"] != null)
        {
            <div class="alert alert-success">@TempData["Meldung"]</div>
        }
        @if (TempData["Fehler"] != null)
        {
            <div class="alert alert-danger">@TempData["Fehler"]</div>
        }

        @RenderBody()
    </main>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
