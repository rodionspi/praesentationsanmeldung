@{
    ViewData["Title"] = "Login";
}

<div class="row justify-content-center">
    <div class="col-12 col-sm-8 col-md-6 col-lg-4">
        <form method="post" class="card card-body">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3">
                <label for="benutzername" class="form-label">Benutzername oder E-Mail</label>
                <input id="benutzername" name="benutzername" class="form-control" autocomplete="username" required />
            </div>
            <div class="mb-3">
                <label for="passwort" class="form-label">Passwort</label>
                <input id="passwort" name="passwort" type="password" class="form-control" autocomplete="current-password" required />
            </div>
            <button type="submit" class="btn btn-primary w-100">Anmelden</button>
        </form>
    </div>
</div>
