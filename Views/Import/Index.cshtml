@{
    ViewData["Title"] = "CSV-Import";
}

<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

<div class="card mb-4">
    <div class="card-body">
        <h2 class="h5">G3SuS</h2>
        <p>Kopfzeile: <code>Vorname;Nachname;Klasse;Email;Passwort</code></p>
        <form asp-action="G3SusImportieren" enctype="multipart/form-data" method="post">
            <input type="file" name="datei" accept=".csv" class="form-control mb-2" required>
            <button type="submit" class="btn btn-primary">Importieren</button>
        </form>
    </div>
</div>

<div class="card mb-4">
    <div class="card-body">
        <h2 class="h5">Präsentationen</h2>
        <p>Kopfzeile: <code>Titel;Beschreibung;Beginn;Raum</code></p>
        <form asp-action="PraesentationenImportieren" enctype="multipart/form-data" method="post">
            <input type="file" name="datei" accept=".csv" class="form-control mb-2" required>
            <button type="submit" class="btn btn-primary">Importieren</button>
        </form>
    </div>
</div>
